# =====================================================================
# FREE VISION AI API KEYS
# =====================================================================

# Option 1: OpenRouter Vision API (FREE Tier - Qwen 2.5 VL / LLaMA 3.2 Vision)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Option 2: Google Gemini Vision API (FREE Tier - 15 requests/minute)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option 3: Groq Vision API (FREE Tier - LLaMA 3.2 11B Vision)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Option 4: HuggingFace Free Inference API (FREE Tier)
# Get a free key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# =====================================================================
# CLOUDINARY MEDIA PROCESSING PIPELINE
# =====================================================================
# Dashboard -> Settings -> API Keys (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Media Pipeline Microservice URL
MEDIA_PIPELINE_URL=http://localhost:5001
CLOUDINARY_ROOT_FOLDER=smart-catalog

